{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    ["@semantic-release/exec", {
      "prepareCmd": "sed -i 's/\\(<addon id=\"plugin.program.8nime.wizard\"[^>]*version=\"\\)[^\"]*/\\1${nextRelease.version}/' wizard/plugin.program.8nime.wizard/addon.xml"
    }],
    ["@semantic-release/git", {
      "assets": ["wizard/plugin.program.8nime.wizard/addon.xml"],
      "message": "chore: bump version to ${nextRelease.version} [skip ci]"
    }],
    "@semantic-release/github"
  ]
}
