<advancedsettings version="1.0">
  <!-- Verbose diagnostic logging (debug build). loglevel 1 = DEBUG; pair with
       guisettings debug.showloginfo/extralogging so kodi.log captures every
       plugin GetDirectory call + result, addon python output, and components. -->
  <loglevel hide="false">1</loglevel>
  <debug>
    <extralogging>true</extralogging>
  </debug>
  <cache>
    <buffermode>1</buffermode>
    <memorysize>209715200</memorysize>
    <readfactor>4.0</readfactor>
  </cache>
  <network>
    <curlclienttimeout>30</curlclienttimeout>
    <curllowspeedtime>20</curllowspeedtime>
    <curlretries>2</curlretries>
    <buffermode>1</buffermode>
    <cachemembuffersize>5242880</cachemembuffersize>
    <readbufferfactor>4.0</readbufferfactor>
  </network>
  <video>
    <subsdelayrange>30</subsdelayrange>
    <audiodelayrange>10</audiodelayrange>
    <usetimeseeking>true</usetimeseeking>
    <timeseekforward>30</timeseekforward>
    <timeseekbackward>-30</timeseekbackward>
    <timeseekforwardbig>300</timeseekforwardbig>
    <timeseekbackwardbig>-300</timeseekbackwardbig>
    <ignoresecondsatstart>90</ignoresecondsatstart>
    <ignorepercentatend>5</ignorepercentatend>
    <playcountminimumpercent>90</playcountminimumpercent>
  </video>
  <lookandfeel>
    <skincolors>SKINDEFAULT</skincolors>
    <skintheme>SKINDEFAULT</skintheme>
    <skinzoom>0</skinzoom>
  </lookandfeel>
</advancedsettings>
