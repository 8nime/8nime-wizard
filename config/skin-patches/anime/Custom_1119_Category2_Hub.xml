<?xml version="1.0" encoding="utf-8"?>
<!-- BINGIE -->
<window id="1119">
    <defaultcontrol always="true">77777</defaultcontrol>
    <menucontrol>900</menucontrol>
    <include>CustomBingieWinProps</include>
    <include>BingieViews_WindowOpen_Fade</include>
    <controls>
		<include>Defs_TMDbBingieHelper_Loader</include>
		<!-- Global Background -->
		<include>GlobalBackground</include>
        <!--NowPlaying-->
        <include>NowPlayingBackground</include>
        <!-- hidden submenu for count calculations -->
        <include condition="!Skin.HasSetting(DisableAllSubmenus)">hiddenSubmenu</include>
		<control type="group">
			<visible>!Player.HasVideo</visible>
			<control type="group">
				<control type="image">
					<width>1920</width>
					<height>1080</height>
					<aspectratio>scale</aspectratio>
					<texture>colors/color_black.png</texture>
				</control>
				<control type="image">
					<width>1920</width>
					<height>1080</height>
					<aspectratio>scale</aspectratio>
					<fadetime>400</fadetime>
					<animation effect="fade" time="400">VisibleChange</animation>
					<texture background="true">$VAR[CategoriesRandomArt]</texture>
				</control>
				<control type="image">
					<width>1920</width>
					<height>1080</height>
					<texture background="true">overlays/gradient_categories.png</texture>
				</control>
				<control type="image">
					<width>1920</width>
					<height>1080</height>
					<texture background="true">overlays/gradient_screensaver.png</texture>
				</control>
			</control>						
			<control type="group">
				<top>820</top>
				<left>1350</left>
				<control type="image" id="9005">
					<height>190</height>                                     
					<width>490</width>
					<align>right</align>
					<fadetime>350</fadetime>
					<aspectratio align="right" aligny="center">keep</aspectratio>
					<texture background="true" fallback="colors/color_transparent.png">$VAR[CategoriesRandomClearLogo]</texture>
				</control>
			</control>	
			<control type="group">
				<top>820</top>
				<left>1310</left>
				<control type="textbox" id="9006">
					<visible>String.EndsWith(Control.GetLabel(9005),color_transparent.png)</visible>
					<height>194</height>
					<width>540</width>
					<font>title</font> 
					<align>right</align>
					<aligny>center</aligny>
					<textcolor>$INFO[Skin.String(BingieLabelTextColor)]</textcolor>
					<label>$VAR[CategoriesRandomTitle]</label>
					<autoscroll delay="4000" time="2000" repeat="6000">true</autoscroll>
				</control>
			</control>
		</control>	
        <control type="list" id="77777">
        <orientation>vertical</orientation>
        <top>81</top>
        <left>137</left>
		<onleft condition="$EXP[IsBingieViewsActive]">SetFocus(900,$INFO[Window(Home).Property(menupos)])</onleft>
		<onback condition="$EXP[IsBingieViewsActive]">900</onback>
		<onback condition="$EXP[IsBingieViewsActive]">SetFocus(900,$INFO[Window(Home).Property(menupos)])</onback>
        <animation effect="fade" start="0" end="100" time="400">Visible</animation>
        <itemlayout width="600" height="90">
          <control type="label">
			<posx>32</posx>
			<height>70</height>
			<aligny>center</aligny>
            <label>$INFO[ListItem.Label]</label>
            <align>left</align>
            <font>category</font>
			<textcolor>$INFO[Skin.String(BingiePrimaryTextColor)]</textcolor>
			<animation end="50" effect="fade" time="0" condition="true">Conditional</animation>
          </control>
        </itemlayout>
        <focusedlayout width="600" height="90">
		<control type="image">
			<posy>1</posy>
			<width>10</width>
			<height>70</height>
			<texture background="true" colordiffuse="$VAR[CategoriesColors]">bingie/line.png</texture>
		</control>
        <control type="label">
			<posx>32</posx>
			<height>70</height>
            <align>left</align>
			<aligny>center</aligny>
            <label>$INFO[ListItem.Label]</label>
            <font>Bold50</font>
            <textcolor>$INFO[Skin.String(BingiePrimaryTextColor)]</textcolor>
          </control>
        </focusedlayout>
