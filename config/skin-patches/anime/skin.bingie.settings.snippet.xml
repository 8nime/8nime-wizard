<!-- 8nime Bingie skin settings overrides -->
<setting id="usebingieinfodialog" type="bool">true</setting>
<setting id="bingieautotrailer" type="bool">true</setting>
<setting id="spotlighttrailers" type="bool">true</setting>
<setting id="trailersource" type="string">youtube</setting>
<setting id="ratings_Trakt" type="bool">false</setting>
<setting id="videoinfo_button_trakt" type="bool">false</setting>
<setting id="addraitingtrakt" type="bool">false</setting>
<setting id="addtofavorites" type="bool">false</setting>
<setting id="enableratings" type="bool">false</setting>
<setting id="splash_screen" type="string">bingie_image</setting>
<setting id="splash_screen.label" type="string">8nime splash</setting>
<setting id="splash_duration" type="string">3</setting>
<setting id="bingiefirststartupdone" type="bool">true</setting>
<setting id="bingiesecondstartupdone" type="bool">true</setting>
<!-- Spotlight (home hero + per-hub) content. The skin loads each as a container
     via $INFO[Skin.String(spotlight*.path)] and renders nothing when empty (the
     stock TMDb paths don't apply to our AniList helper). Point them at the
     helper's trending route so the spotlight + New&Popular hub populate. -->
<setting id="spotlighthome.path" type="string">plugin://plugin.video.8nime.bingie.helper/?info=trakt_trending&amp;tmdb_type=tv</setting>
<setting id="spotlightnew.path" type="string">plugin://plugin.video.8nime.bingie.helper/?info=trakt_trending&amp;tmdb_type=tv</setting>
<setting id="spotlighttvshows.path" type="string">plugin://plugin.video.8nime.bingie.helper/?info=trakt_trending&amp;tmdb_type=tv</setting>
<setting id="spotlightmovies.path" type="string">plugin://plugin.video.8nime.bingie.helper/?info=trakt_trending&amp;tmdb_type=movie</setting>
